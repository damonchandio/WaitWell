# WaitWell environment variables
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is git-ignored. This file is committed, so it must never contain a real key.
#
# ANYTHING PREFIXED VITE_ IS COMPILED INTO THE JAVASCRIPT BUNDLE AND IS PUBLIC.
# Anyone can open devtools and read it. Only put keys here that are designed to
# be public. Everything else belongs in Supabase Edge Function secrets, set with:
#     supabase secrets set NAME=value


# ---------------------------------------------------------------------------
# Supabase (client side, safe to expose)
# ---------------------------------------------------------------------------
# Found in Supabase dashboard > Project Settings > API.
# The anon key is meant to be public. What protects your data is Row Level
# Security on every table, not the secrecy of this key. Check RLS is on.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here


# ---------------------------------------------------------------------------
# Stripe (publishable key only)
# ---------------------------------------------------------------------------
# pk_test_ while developing, pk_live_ in production.
# The SECRET key (sk_) must never appear in this project. It belongs in an
# Edge Function secret.

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key


# ---------------------------------------------------------------------------
# Server side only — DO NOT prefix these with VITE_
# ---------------------------------------------------------------------------
# These are listed for reference. Set them as Edge Function secrets, not here.
# If any of these currently sit in your frontend code with a VITE_ prefix,
# the key is already public and should be rotated.
#
#   GEMINI_API_KEY             Google AI Studio key for the coach and the
#                              letter explainer
#   STRIPE_SECRET_KEY          sk_live_ or sk_test_
#   STRIPE_WEBHOOK_SECRET      whsec_, verifies webhook calls are really Stripe
#   SUPABASE_SERVICE_ROLE_KEY  bypasses Row Level Security — treat as a
#                              database password, never send to a browser


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
